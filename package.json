{
  "name": "intellitest-bdd-suite",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && bddgen && playwright test",
    "test:headed": "npm run typecheck && bddgen && playwright test --headed",
    "report": "playwright show-report report"
  },
  "dependencies": {
    "@playwright/test": "1.64.1",
    "playwright-bdd": "9.2.1"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "22.20.5"
  }
}
